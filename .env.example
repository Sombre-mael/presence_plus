# PostgreSQL connection string used by Prisma.
DATABASE_URL=
DATABASE_URL_E2E=

# Secret used by Auth.js to encrypt cookies and tokens.
AUTH_SECRET=
AUTH_SECRET_E2E=
NEXTAUTH_URL=http://localhost:3000
RESEND_API_KEY=
AUTH_EMAIL_FROM=Presence Plus <no-reply@example.com>
AUTH_EMAIL_MODE=mock
AUTH_E2E_PASSWORD=
E2E_RUN_ID=
ALLOWED_DEV_ORIGINS=127.0.0.1,localhost

# Optional password used for local/demo accounts created by prisma/seed.ts.
SEED_PASSWORD=
