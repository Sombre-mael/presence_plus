# PostgreSQL connection string used by Prisma.
DATABASE_URL=
DATABASE_URL_E2E=

# Secret used by Auth.js to encrypt cookies and tokens.
AUTH_SECRET=
AUTH_SECRET_E2E=
NEXTAUTH_URL=http://localhost:3000
AUTH_EMAIL_MODE=manual
AUTH_EMAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Presence Plus
# Optional address that receives replies from either provider.
AUTH_EMAIL_REPLY_TO=
RESEND_API_KEY=
AUTH_EMAIL_FROM=Presence Plus <no-reply@example.com>
# Use "manual" until a transactional provider is configured, then switch to "live".
# Brevo supports a verified Gmail sender for the temporary domain-free setup.
# Resend remains available once a verified sending domain is available.
# The "mock" mode is reserved for automated tests and local development.
AUTH_E2E_PASSWORD=
E2E_RUN_ID=
ALLOWED_DEV_ORIGINS=127.0.0.1,localhost
# Optional outside Vercel. Change it for every production release to trigger the PWA update prompt.
NEXT_PUBLIC_APP_VERSION=

# Token for a PRIVATE Vercel Blob store used server-side for verified profile pictures.
# Public Blob stores must not be used for new profile-photo submissions.
BLOB_READ_WRITE_TOKEN=

# Web Push keys. Generate a VAPID key pair once and keep the private key server-side.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:presenceplus12@gmail.com

# Explicit opt-in and strong password used only for a disposable local dataset.
ALLOW_DEMO_SEED=false
SEED_PASSWORD=
