# PostgreSQL connection string used by Prisma.
DATABASE_URL=
DATABASE_URL_E2E=

# Secret used by Auth.js to encrypt cookies and tokens.
AUTH_SECRET=
AUTH_SECRET_E2E=
NEXTAUTH_URL=http://localhost:3000
RESEND_API_KEY=
AUTH_EMAIL_FROM=Presence Plus <no-reply@example.com>
# Use "live" outside automated tests. The "mock" mode is forbidden on Vercel production.
AUTH_EMAIL_MODE=live
AUTH_E2E_PASSWORD=
E2E_RUN_ID=
ALLOWED_DEV_ORIGINS=127.0.0.1,localhost

# Explicit opt-in and strong password used only for a disposable local dataset.
ALLOW_DEMO_SEED=false
SEED_PASSWORD=
